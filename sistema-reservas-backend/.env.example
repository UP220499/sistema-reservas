# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Environment  (development | production)
NODE_ENV=development

# Server
PORT=4000

# CORS — comma-separated allowed origins
# In development, leave unset to allow all origins.
# In production, set to the frontend URL(s).
ALLOWED_ORIGINS=https://your-frontend.netlify.app

# Database — replace USER / PASSWORD with real credentials
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sistema_reservas?schema=public"

# Throttling
# Set to true in development to bypass rate limiting (10 000 req / 60 s).
# In production leave unset or set to false (10 req / 60 s enforced).
THROTTLE_DISABLED=true

# iCal sync
ICAL_SYNC_ENABLED=true
ICAL_SYNC_CRON=*/15 * * * *
ICAL_SYNC_VERBOSE=false

# JWT
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Airbnb iCal URLs — one entry per listing, suffix = ubication ID in DB
AIRBNB_ICAL_URL_2="https://example.com/calendar/ical/listing-2.ics"
AIRBNB_ICAL_URL_3="https://example.com/calendar/ical/listing-3.ics"
AIRBNB_ICAL_URL_6="https://example.com/calendar/ical/listing-6.ics"
AIRBNB_ICAL_URL_8="https://example.com/calendar/ical/listing-8.ics"
AIRBNB_ICAL_URL_9="https://example.com/calendar/ical/listing-9.ics"
AIRBNB_ICAL_URL_10="https://example.com/calendar/ical/listing-10.ics"
AIRBNB_ICAL_URL_11="https://example.com/calendar/ical/listing-11.ics"
AIRBNB_ICAL_URL_12="https://example.com/calendar/ical/listing-12.ics"